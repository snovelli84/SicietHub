<?xml version="1.0" encoding="UTF-8"?>
<!--
  Componente aggiuntivo di Outlook "MailStore SICIET".
  Aggiunge in Outlook Web / nuovo Outlook un pulsante che apre MailStore Web Access.
  Si installa dall'interfaccia di amministrazione di Microsoft 365:
  Impostazioni > App integrate > Carica app personalizzate > Componente aggiuntivo di Office > carica questo file.
  Se si modifica il file, aumentare <Version>; l'<Id> non va mai cambiato.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>63287dca-1225-4200-9d91-b1a6ea0b84df</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>SICIET</ProviderName>
  <DefaultLocale>it-IT</DefaultLocale>
  <DisplayName DefaultValue="MailStore SICIET"/>
  <Description DefaultValue="Apre l'archivio della posta aziendale MailStore."/>
  <IconUrl DefaultValue="https://hub.siciet.it/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://hub.siciet.it/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="https://hub.siciet.it/"/>
  <AppDomains>
    <AppDomain>https://hub.siciet.it</AppDomain>
    <AppDomain>https://mailstore.siciet.it</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://hub.siciet.it/outlook/mailstore.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>Restricted</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Pulsante visibile quando si legge un messaggio -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mailstoreReadGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="mailstoreReadButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://hub.siciet.it/outlook/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://hub.siciet.it/outlook/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://hub.siciet.it/outlook/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://hub.siciet.it/outlook/mailstore.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="MailStore"/>
        <bt:String id="Button.Label" DefaultValue="MailStore"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Apre l'archivio della posta aziendale MailStore."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
